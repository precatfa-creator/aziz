# GEMINI_API_KEY: server-only, used by api/ai/*.ts. Set in Vercel project env vars.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase — auto-provisioned by the Vercel Marketplace Supabase integration
# (`vercel integration add supabase`) and pulled locally with `vercel env pull`.
# NEXT_PUBLIC_* names are what the integration injects; vite.config.ts exposes
# them to the client bundle via envPrefix.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# Server-side (api/_lib/verifyUser.ts) — same anon key, non-public name.
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
